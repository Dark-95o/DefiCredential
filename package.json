{
  "name": "cloakpass-monorepo",
  "private": true,
  "workspaces": [
    "contract",
    "indexer",
    "ui"
  ],
  "scripts": {
    "build": "npm run build --workspace=ui",
    "compile": "npm run compile --workspace=contract",
    "compile:contract": "npm run compile --workspace=contract",
    "test": "npm test --workspace=contract && npm test --workspace=ui",
    "dev:ui": "npm run dev --workspace=ui",
    "start:indexer": "npm run start --workspace=indexer",
    "lint": "npm run lint --workspace=ui"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  },
  "keywords": [
    "midnight-network",
    "zero-knowledge",
    "compact",
    "zk-snark",
    "privacy"
  ]
}
